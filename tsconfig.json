{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "incremental": true,
    "baseUrl": ".",
    "types": ["bcryptjs", "chalk", "node"],
    "paths": {
      "@/*": ["src/*"],
      "@/lib/*": ["src/lib/*"],
      "@/env/*": ["src/lib/env/*"],
      "@/auth/*": ["src/lib/auth/*"],
      "@/token/*": ["src/lib/token/*"],
      "@/token": ["src/lib/token/index.ts"],
      "@/utils/*": ["src/lib/utils/*"],
      "@/infrastructure/*": ["src/infrastructure/*"],
      "@/shared/*": ["src/shared/*"],
      "@/domains/*": ["src/domains/*"],
      "@/shared/constants/*": ["src/shared/constants/*"],
      "@/logging/*": ["src/infrastructure/logging/*"],
      "@/prisma": ["src/infrastructure/db/prisma.ts"],
      "@/lotties/*": ["src/lib/lotties/*"],
      "@/components/*": ["src/components/*"],
      "@/onboarding/*": ["src/components/onboarding/*"],
      "@/styles/*": ["src/styles/*"],
      "@/hooks/*": ["src/hooks/*"],
      "@/stores/*": ["src/stores/*"],
      "staging/*": ["staging/*"],
      "@/cli/*": ["cli/*"],
      "@/scripts/*": ["scripts/*"],
      "@/flows/*": ["scripts/partner-tokens/utils/flows/*"],
      "@/types/*": ["src/shared/types/*"],
      "@/shared/types/*": ["src/shared/types/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "src",
    "app/api",
    "cli",
    "lib",
    "scripts",
    "middleware.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "types/global.d.ts",
    "src/lib/prisma.ts",
    // Explicit .tsx files
    "staging/decodeTokenCLIFlow.ts",
    "staging/SharedDocViewer.tsx",
    "staging/hooks/useOrbSize.ts",
    "staging/sendCadaNotification.tsx",
    "staging/cada",
    "staging/test-email",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "src/_archive",
    "src/**/_archive/**"
  ]
}
