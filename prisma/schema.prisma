generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                   @id @default(cuid())
  username              String                   @unique
  passwordHash          String
  email                 String                   @unique
  isAdmin               Boolean                  @default(false)
  accessToken           String?                  @unique
  accessTokenHash       String?
  accessTokenIssuedAt   DateTime?
  name                  String?
  displayName           String?
  tier                  String?
  partnerSlug           String?
  updatedAt             DateTime                 @updatedAt
  createdAt             DateTime                 @default(now())
  lastLogin             DateTime?
  loginCount            Int                      @default(0)
  viewedDocs            String[]
  blockchainWalletId    String?                  @unique
  metadata              Json?
  balances              Balance[]
  blockchainWallet      BlockchainWallet?
  Case                  Case[]
  CaseArtifact          CaseArtifact[]
  CaseEvent             CaseEvent[]
  CaseParty             CaseParty[]
  contractLogs          ContractInteractionLog[]
  councilElder          CouncilElder?
  documents             Document[]
  initiativesAuthored   Initiative[]             @relation("InitiativesCreatedBy")
  initiativeFundings    InitiativeFunding[]
  initiativeUpdates     InitiativeUpdate[]       @relation("InitiativeUpdatesByUser")
  investmentProposals   InvestmentProposal[]
  logoutLogs            LogoutLog[]
  nftBadges             NFTBadge[]
  nodeSyncStatuses      NodeSyncStatus[]
  projects              Project[]
  reviews               ProjectReview[]          @relation("Reviewer")
  revokedTokens         RevokedToken[]
  sessions              Session[]
  sessionActionLogs     SessionActionLog[]
  sessionLogs           SessionLog[]
  simProfiles           SimProfile[]
  stakes                Stake[]
  createdTokens         Token[]                  @relation("TokensCreatedBy")
  tokenIssuanceRequests TokenIssuanceRequest[]   @relation("RequestsByUser")
  transactions          Transaction[]
  userRoles             UserRole[]

  createdCommunicationConversations    CommunicationConversation[]    @relation("CommunicationConversationCreator")
  communicationMemberships             CommunicationMember[]          @relation("CommunicationMembership")
  sentCommunicationMessages            CommunicationMessage[]         @relation("CommunicationMessageSender")
  createdCommunicationOperationalRooms CommunicationOperationalRoom[] @relation("CommunicationOperationalRoomCreator")
  createdCommunicationOperationalLinks CommunicationOperationalLink[] @relation("CommunicationOperationalLinkCreator")

  institutionalInstrumentsCreated InstitutionalInstrument[] @relation("InstitutionalInstrumentCreator")
  instrumentVersionsCreated       InstrumentVersion[]       @relation("InstrumentVersionCreator")
  instrumentResponsesAuthored     InstrumentResponse[]      @relation("InstrumentResponseActor")
  instrumentParties               InstrumentParty[]         @relation("InstrumentPartyUser")
  instrumentAccessGrantsReceived  InstrumentAccessGrant[]   @relation("InstrumentAccessRecipient")
  instrumentAccessGrantsIssued    InstrumentAccessGrant[]   @relation("InstrumentAccessIssuer")

  instrumentAuthoritiesCreated InstrumentAuthority[]       @relation("InstrumentAuthorityCreator")
  instrumentTransitionsActed   InstrumentStateTransition[] @relation("InstrumentTransitionActor")
  instrumentEvidenceRecorded   InstrumentEvidence[]        @relation("InstrumentEvidenceRecorder")
  instrumentRelationsCreated   InstrumentRelation[]        @relation("InstrumentRelationCreator")

  representativeProgramParticipants        RepresentativeProgramParticipant[]        @relation("RepresentativeProgramParticipantUser")
  representativeProgramParticipantsCreated RepresentativeProgramParticipant[]        @relation("RepresentativeProgramParticipantCreator")
  representativeProgramAppointmentsCreated RepresentativeProgramAppointment[]        @relation("RepresentativeProgramAppointmentCreator")
  representativeProgramStandingActed       RepresentativeProgramStandingTransition[] @relation("RepresentativeProgramStandingActor")

  wallets Wallet?
}

// ============================================================================
// INSTITUTIONAL INSTRUMENTS
// Governed relationship, proposition, deliberation and access architecture.
// Distinct from TransactionDossierInstrument, which represents transaction
// execution/document artifacts.
// ============================================================================

model InstitutionalInstrument {
  id              String                        @id @default(cuid())
  reference       String                        @unique
  kind            InstitutionalInstrumentKind
  title           String
  status          InstitutionalInstrumentStatus @default(DRAFT)
  currentVersion  Int                           @default(1)
  createdByUserId String

  createdBy User @relation("InstitutionalInstrumentCreator", fields: [createdByUserId], references: [id])

  versions                         InstrumentVersion[]
  parties                          InstrumentParty[]
  accessGrants                     InstrumentAccessGrant[]
  authorities                      InstrumentAuthority[]
  stateTransitions                 InstrumentStateTransition[]
  evidence                         InstrumentEvidence[]
  outboundRelations                InstrumentRelation[]              @relation("InstrumentRelationSource")
  inboundRelations                 InstrumentRelation[]              @relation("InstrumentRelationTarget")
  digitalSettlementInstruction     DigitalSettlementInstruction?
  representativeProgramAppointment RepresentativeProgramAppointment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([status])
  @@index([createdByUserId])
  @@index([updatedAt])
}

model DigitalSettlementInstruction {
  id                         String                         @id @default(cuid())
  instrumentId               String                         @unique
  publicId                   String                         @unique
  counterpartyName           String
  counterpartyRepresentative String?
  commodity                  String                         @default("Au Dore Bars")
  transactionDescription     String
  settlementPurpose          String
  proceduralBasis            String
  quantityKg                 Decimal                        @db.Decimal(18, 6)
  pricingStatus              DigitalSettlementPricingStatus @default(PENDING_FIXING)
  pricingBasis               String
  spotDiscountPercentage     Decimal                        @default(10) @db.Decimal(7, 4)
  spotBenchmark              String?
  spotPricePerKgUsd          Decimal?                       @db.Decimal(20, 2)
  pricePerKgUsd              Decimal?                       @db.Decimal(20, 2)
  transactionValueUsd        Decimal?                       @db.Decimal(20, 2)
  settlementPercentage       Decimal                        @db.Decimal(7, 4)
  settlementAmountUsd        Decimal?                       @db.Decimal(20, 2)
  priceFixedAt               DateTime?
  settlementAsset            DigitalSettlementAsset
  settlementNetwork          DigitalSettlementNetwork
  receivingEntity            String
  receivingAddress           String?
  receivingWalletId          String?
  receivingWalletRole        String?
  verificationAmountUsdt     Decimal                        @default(50) @db.Decimal(20, 6)
  verificationTxHash         String?                        @unique
  verificationConfirmedAt    DateTime?
  principalAuthorizedAt      DateTime?
  settlementStatus           DigitalSettlementStatus        @default(PENDING_ISSUANCE)
  settlementDetectedAt       DateTime?
  settlementConfirmedAt      DateTime?

  instrument InstitutionalInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([settlementStatus])
  @@index([settlementAsset, settlementNetwork])
}

model InstrumentVersion {
  id              String                  @id @default(cuid())
  instrumentId    String
  number          Int
  status          InstrumentVersionStatus @default(DRAFT)
  createdByUserId String
  issuedAt        DateTime?
  supersededAt    DateTime?

  instrument InstitutionalInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  createdBy  User                    @relation("InstrumentVersionCreator", fields: [createdByUserId], references: [id])

  propositions InstrumentProposition[]
  accessGrants InstrumentAccessGrant[] @relation("InstrumentVersionAccessGrants")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instrumentId, number])
  @@index([instrumentId, status])
  @@index([createdByUserId])
  @@index([issuedAt])
}

model InstrumentProposition {
  id        String                     @id @default(cuid())
  versionId String
  reference String
  domain    String
  title     String
  body      String
  state     InstrumentPropositionState
  ordinal   Int

  version InstrumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  responses InstrumentResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([versionId, reference])
  @@unique([versionId, ordinal])
  @@index([versionId, state])
  @@index([domain])
}

model InstrumentResponse {
  id                   String                 @id @default(cuid())
  propositionId        String
  actorUserId          String
  responseType         InstrumentResponseType
  note                 String?
  supersedesResponseId String?                @unique
  supersededAt         DateTime?

  proposition InstrumentProposition @relation(fields: [propositionId], references: [id], onDelete: Cascade)
  actor       User                  @relation("InstrumentResponseActor", fields: [actorUserId], references: [id])

  supersedes   InstrumentResponse? @relation("InstrumentResponseSupersession", fields: [supersedesResponseId], references: [id], onDelete: SetNull)
  supersededBy InstrumentResponse? @relation("InstrumentResponseSupersession")

  createdAt DateTime @default(now())

  @@index([propositionId, actorUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([responseType])
}

model InstrumentParty {
  id             String              @id @default(cuid())
  instrumentId   String
  userId         String?
  displayName    String
  role           InstrumentPartyRole
  authorityClass String?

  instrument InstitutionalInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  user       User?                   @relation("InstrumentPartyUser", fields: [userId], references: [id], onDelete: SetNull)

  authorities InstrumentAuthority[]

  representativeProgramAppointment RepresentativeProgramAppointment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instrumentId, role])
  @@index([userId])
}

model InstrumentAccessGrant {
  id                  String                @id @default(cuid())
  instrumentId        String
  instrumentVersionId String?
  recipientUserId     String?
  recipientName       String?
  recipientRole       InstrumentPartyRole
  accessLevel         InstrumentAccessLevel
  codeHash            String?               @unique
  issuedByUserId      String

  issuedAt      DateTime  @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  firstAccessAt DateTime?
  lastAccessAt  DateTime?

  instrument        InstitutionalInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  instrumentVersion InstrumentVersion?      @relation("InstrumentVersionAccessGrants", fields: [instrumentVersionId], references: [id], onDelete: SetNull)
  recipientUser     User?                   @relation("InstrumentAccessRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  issuedBy          User                    @relation("InstrumentAccessIssuer", fields: [issuedByUserId], references: [id])

  @@index([instrumentId, accessLevel])
  @@index([instrumentVersionId])
  @@index([recipientUserId])
  @@index([issuedByUserId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// ============================================================================
// AUTHORIZED REPRESENTATION PROGRAM
// Program participant identity, docket, appointment and standing spine.
// Program Standing is intentionally distinct from InstitutionalInstrumentStatus.
// Appointment Class is intentionally distinct from InstrumentAuthority.
// ============================================================================

model RepresentativeProgramDocketSequence {
  year       Int      @id
  nextNumber Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model RepresentativeProgramParticipant {
  id              String                        @id @default(cuid())
  docketReference String                        @unique
  userId          String?
  displayName     String
  standing        RepresentativeProgramStanding
  admittedAt      DateTime?
  createdByUserId String

  user      User? @relation("RepresentativeProgramParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy User  @relation("RepresentativeProgramParticipantCreator", fields: [createdByUserId], references: [id])

  appointments        RepresentativeProgramAppointment[]
  standingTransitions RepresentativeProgramStandingTransition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([standing])
  @@index([createdByUserId])
}

model RepresentativeProgramAppointment {
  id                String                         @id @default(cuid())
  participantId     String
  instrumentId      String                         @unique
  instrumentPartyId String                         @unique
  appointmentClass  RepresentativeAppointmentClass
  scope             Json?
  effectiveAt       DateTime?
  expiresAt         DateTime?
  endedAt           DateTime?
  createdByUserId   String

  participant     RepresentativeProgramParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  instrument      InstitutionalInstrument          @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  instrumentParty InstrumentParty                  @relation(fields: [instrumentPartyId], references: [id], onDelete: Restrict)
  createdBy       User                             @relation("RepresentativeProgramAppointmentCreator", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId])
  @@index([appointmentClass])
  @@index([effectiveAt])
  @@index([expiresAt])
  @@index([endedAt])
}

model RepresentativeProgramStandingTransition {
  id            String                         @id @default(cuid())
  participantId String
  fromStanding  RepresentativeProgramStanding?
  toStanding    RepresentativeProgramStanding
  actorUserId   String
  reason        String?
  metadata      Json?
  occurredAt    DateTime                       @default(now())

  participant RepresentativeProgramParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  actor       User                             @relation("RepresentativeProgramStandingActor", fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([participantId, occurredAt])
  @@index([participantId, toStanding])
  @@index([actorUserId])
}

enum RepresentativeAppointmentClass {
  REGISTERED_COMMERCIAL_INTRODUCER
  AUTHORIZED_COMMERCIAL_REPRESENTATIVE
  TRANSACTION_REPRESENTATIVE
  COMMERCIAL_MANDATE
}

enum RepresentativeProgramStanding {
  PROVISIONAL
  ACTIVE
  RESTRICTED
  SUSPENDED
  EXPIRED
  WITHDRAWN
  REVOKED
}

enum InstitutionalInstrumentKind {
  ROYAL_CUSTODIAL_FRAMEWORK
  REPRESENTATIVE_MANDATE
  REPRESENTATIVE_APPOINTMENT
  LETTER_OF_INTENT
  COOPERATION_FRAMEWORK
  DIGITAL_SETTLEMENT_INSTRUCTION
  GENERAL
}

enum DigitalSettlementAsset {
  USDT
}

enum DigitalSettlementNetwork {
  ETHEREUM_ERC20
}

enum DigitalSettlementPricingStatus {
  PENDING_FIXING
  FIXED
}

enum DigitalSettlementStatus {
  PENDING_ISSUANCE
  AWAITING_VERIFICATION_TRANSFER
  VERIFICATION_CONFIRMED
  AWAITING_TRANSFER
  DETECTED
  CONFIRMING
  CONFIRMED
  FAILED_REVIEW
  CANCELLED
}

enum InstitutionalInstrumentStatus {
  DRAFT
  INTERNAL_REVIEW
  ISSUED
  ACCESSED
  UNDER_DELIBERATION
  CLARIFICATION_OPEN
  REVISION_PENDING
  PRINCIPLES_ALIGNED
  DEFINITIVE_INSTRUMENT_PENDING
  EXECUTION_PENDING
  EXECUTED
  ACTIVE
  ARCHIVED
}

enum InstrumentVersionStatus {
  DRAFT
  ISSUED
  SUPERSEDED
  ARCHIVED
}

enum InstrumentPropositionState {
  CONFIRMED
  UNDERSTOOD
  PROPOSED
  OPEN
  REVISED
  DECLINED
  SUPERSEDED
}

enum InstrumentResponseType {
  ACKNOWLEDGE
  AFFIRM
  CLARIFY
  REVISE
  DECLINE
}

enum InstrumentPartyRole {
  PRINCIPAL
  CUSTODIAN
  DELIBERATOR
  REVIEWER
  OBSERVER
  COMMERCIAL_PARTICIPANT
}

enum InstrumentAccessLevel {
  VIEW
  RESPOND
  DELIBERATE
  ADMINISTER
}

model UserTrustEdge {
  id              String    @id @default(cuid())
  fromUserId      String
  toUserId        String
  transferCount   Int       @default(0)
  successfulCount Int       @default(0)
  failedCount     Int       @default(0)
  lastTransferAt  DateTime?
  trustScore      Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastUpdatedAt   DateTime  @default(now())

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  grantedBy String?
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  isActive  Boolean   @default(true)
  role      Role      @relation(fields: [roleId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@index([userId, isActive])
  @@index([roleId, isActive])
}

model Role {
  id              String           @id @default(cuid())
  key             String           @unique
  label           String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model AccessCode {
  id           String    @id @default(cuid())
  codeHash     String    @unique
  humanCode    String?
  partner      String
  tier         String
  email        String?
  docs         String[]  @default([])
  displayName  String?
  greeting     String?
  popupMessage String?
  expiresAt    DateTime?
  maxUses      Int       @default(1)
  usedCount    Int       @default(0)
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastUsedAt   DateTime?
  lastUsedIp   String?
}

model SessionLog {
  id        String   @id @default(cuid())
  userId    String
  timestamp DateTime @default(now())
  ip        String?
  location  String?
  device    String?
  action    String   @default("login")
  path      String?
  details   Json?
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  label           String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model PinLoginRequest {
  id           String    @id @default(cuid())
  email        String    @unique
  pinHash      String
  attemptCount Int       @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Wallet {
  id               String            @id @default(cuid())
  userId           String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  balances         Balance[]
  blockchainWallet BlockchainWallet?
  transactions     Transaction[]
  user             User              @relation(fields: [userId], references: [id])
}

model Balance {
  id              String     @id @default(cuid())
  walletId        String
  userId          String
  tokenType       TokenType?
  tokenId         String?
  amount          Float      @default(0)
  amountBaseUnits Decimal?   @db.Decimal(78, 0)
  assetCode       String?
  token           Token?     @relation(fields: [tokenId], references: [id])
  user            User       @relation(fields: [userId], references: [id])
  wallet          Wallet     @relation(fields: [walletId], references: [id])

  @@unique([walletId, tokenType, tokenId])
  @@index([walletId])
  @@index([userId])
  @@index([tokenType])
  @@index([tokenId])
  @@index([assetCode])
}

model BlockchainWallet {
  id        String   @id @default(cuid())
  walletId  String   @unique
  userId    String   @unique
  address   String?  @unique
  createdAt DateTime @default(now())
  network   String?
  user      User     @relation(fields: [userId], references: [id])
  wallet    Wallet   @relation(fields: [walletId], references: [id])
}

model Transaction {
  id              String     @id @default(cuid())
  userId          String
  walletId        String
  type            String
  amount          Float
  tokenType       TokenType?
  tokenId         String?
  txHash          String?
  metadata        Json?
  createdAt       DateTime   @default(now())
  amountBaseUnits Decimal?   @db.Decimal(78, 0)
  assetCode       String?
  feeBaseUnits    Decimal?   @db.Decimal(78, 0)
  intent          String?
  idempotencyKey  String?    @unique
  token           Token?     @relation(fields: [tokenId], references: [id])
  user            User       @relation(fields: [userId], references: [id])
  wallet          Wallet     @relation(fields: [walletId], references: [id])

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([tokenId])
  @@index([tokenType])
  @@index([assetCode])
}

model TransactionIntake {
  id        String @id @default(cuid())
  reference String @unique

  status String @default("SUBMITTED")

  submitterName    String
  submitterEmail   String
  submitterPhone   String?
  submitterCompany String?
  submitterCountry String?

  submitterRole        String
  representedPartyType String?
  representedPartyName String?
  authorizationStatus  String?

  program          String?
  transactionType  String?
  commodity        String?
  quantity         String?
  trialQuantity    String?
  monthlyQuantity  String?
  origin           String?
  destination      String?
  deliveryTerms    String?
  settlementMethod String?
  expectedTimeline String?

  buyerName          String?
  sellerName         String?
  refineryPreference String?
  financialReadiness String?
  documentsAvailable String?
  supportingNotes    String?

  // ─────────────────────────────────────
  // LOI V4 — COUNTERPARTY IDENTITY
  // ─────────────────────────────────────

  buyerRegistrationNumber     String?
  buyerCountryOfIncorporation String?
  buyerRegisteredAddress      String?
  buyerBusinessAddress        String?
  buyerCorporateEmail         String?
  buyerCorporatePhone         String?

  buyerRepresentativeName         String?
  buyerRepresentativeTitle        String?
  buyerRepresentativeEntity       String?
  buyerRepresentativeEmail        String?
  buyerRepresentativePhone        String?
  buyerRepresentativeRelationship String?

  authorityToRepresent Boolean @default(false)
  authorityToNegotiate Boolean @default(false)
  authorityToSign      Boolean @default(false)
  authorityOther       String?

  externalParticipants Json?

  // ─────────────────────────────────────
  // LOI V4 — TRANSACTION PROFILE
  // ─────────────────────────────────────

  requestedPurity        String?
  transactionPurpose     String?
  transactionWindow      String?
  continuingSupplyIntent String?
  recurringQuantity      String?
  recurringFrequency     String?
  desiredTerm            String?
  destinationStatus      String?
  buyerRequirements      String?

  // ─────────────────────────────────────
  // LOI V4 — DELIVERY / ASSAY
  // ─────────────────────────────────────

  deliveryPathway             String?
  deliveryPoint               String?
  buyerRepresentativesPresent String?
  buyerRepresentative1        String?
  buyerRepresentative2        String?
  refineryJurisdiction        String?
  assayPosture                String?
  additionalAssayRequirements String?

  // ─────────────────────────────────────
  // LOI V4 — SETTLEMENT
  // ─────────────────────────────────────

  settlementPathway                     String?
  settlementRail                        String?
  settlementCurrencyAsset               String?
  settlementTimingRequirement           String?
  bankMessageFormat                     String?
  digitalAsset                          String?
  digitalAssetNetwork                   String?
  additionalSettlementAuthorityRequired String?
  additionalSettlementAuthorityDetail   String?
  financialCapacityStatus               String?

  // ─────────────────────────────────────
  // LOI V4 — READINESS / COMPLIANCE
  // ─────────────────────────────────────

  incorporationRecordAvailable Boolean @default(false)
  kybRecordAvailable           Boolean @default(false)
  representativeIdAvailable    Boolean @default(false)
  authorityDocumentAvailable   Boolean @default(false)

  specialComplianceRequirements String?
  specialComplianceDetail       String?

  // ─────────────────────────────────────
  // LOI V4 — AUTHORIZED SUBMISSION
  // ─────────────────────────────────────

  authorizedSubmitterEntity         String?
  authorizedSubmitterRepresentative String?
  authorizedSubmitterPosition       String?
  authorizedSubmissionDate          String?

  referralCode            String?
  referredByName          String?
  referredByCompany       String?
  referredByEmail         String?
  referredByPhone         String?
  referredByRole          String?
  referralConfirmed       Boolean @default(false)
  compensationExpectation String?

  declarationAccuracy     Boolean @default(false)
  declarationNoObligation Boolean @default(false)
  declarationNoCommission Boolean @default(false)

  internalNotes String?

  promotedOpportunityId String?      @unique
  promotedOpportunity   Opportunity? @relation("TransactionIntakePromotion", fields: [promotedOpportunityId], references: [id], onDelete: SetNull)
  promotedAt            DateTime?
  promotedBy            String?

  sourceUrl String?
  ipAddress String?
  userAgent String?

  events TransactionIntakeEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reference])
  @@index([status])
  @@index([submitterEmail])
  @@index([referralCode])
  @@index([commodity])
  @@index([program])
  @@index([promotedAt])
  @@index([createdAt])
}

model TransactionIntakeEvent {
  id       String @id @default(cuid())
  intakeId String

  eventType  String
  fromStatus String?
  toStatus   String?
  actor      String?
  note       String?

  createdAt DateTime @default(now())

  intake TransactionIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@index([intakeId])
  @@index([eventType])
  @@index([createdAt])
  @@index([toStatus])
}

model IntakeRepresentative {
  id      String  @id @default(cuid())
  code    String  @unique
  name    String
  email   String?
  company String?
  program String?
  status  String  @default("ACTIVE")
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([status])
  @@index([program])
}

model TransactionDossier {
  id        String           @id @default(cuid())
  reference String           @unique
  title     String
