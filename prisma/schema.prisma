enum CommunicationConversationKind {
  DIRECT
  GROUP
}

enum CommunicationConversationStatus {
  ACTIVE
  ARCHIVED
}

enum CommunicationMemberRole {
  OWNER
  MEMBER
}

enum CommunicationMessageKind {
  TEXT
  SYSTEM
  NOTICE
  REQUEST
  DECISION
  APPROVAL_REQUEST
  STATUS_UPDATE
  DOCUMENT_REFERENCE
}

model CommunicationConversation {
  id     String                          @id @default(cuid())
  kind   CommunicationConversationKind
  status CommunicationConversationStatus @default(ACTIVE)

  title     String?
  directKey String? @unique

  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?

  createdBy User @relation("CommunicationConversationCreator", fields: [createdByUserId], references: [id])

  members         CommunicationMember[]
  messages        CommunicationMessage[]
  operationalRoom CommunicationOperationalRoom?

  @@index([createdByUserId, createdAt])
  @@index([status, updatedAt])
}

model CommunicationMember {
  id             String                  @id @default(cuid())
  conversationId String
  userId         String
  role           CommunicationMemberRole @default(MEMBER)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  lastReadMessageId String?
  lastReadAt        DateTime?

  conversation    CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User                      @relation("CommunicationMembership", fields: [userId], references: [id])
  lastReadMessage CommunicationMessage?     @relation("CommunicationLastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
  @@index([conversationId, leftAt])
}

model CommunicationMessage {
  id              String                   @id @default(cuid())
  conversationId  String
  senderUserId    String
  clientMessageId String                   @default(cuid())
  kind            CommunicationMessageKind @default(TEXT)
  body            String
  createdAt       DateTime                 @default(now())

  workflowTargetType    CommunicationOperationalTargetType?
  workflowTargetSubtype String?
  workflowTargetId      String?

  conversation CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                      @relation("CommunicationMessageSender", fields: [senderUserId], references: [id])
  readMarkers  CommunicationMember[]     @relation("CommunicationLastReadMessage")

  @@unique([conversationId, senderUserId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
  @@index([workflowTargetType, workflowTargetSubtype, workflowTargetId])
}

enum CommunicationOperationalRoomClass {
  GENERAL_OPERATIONS
  TRANSACTION
  TREASURY
  DOSSIER
  CASE
  OPPORTUNITY
}

enum CommunicationOperationalTargetType {
  CASE
  OPPORTUNITY
  TRANSACTION_DOSSIER
  TRANSACTION
  TREASURY_GATEWAY_AGGREGATE
}

model CommunicationOperationalRoom {
  id                 String                            @id @default(cuid())
  conversationId     String                            @unique
  clientRoomId       String
  requestFingerprint String
  roomClass          CommunicationOperationalRoomClass

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdBy User @relation("CommunicationOperationalRoomCreator", fields: [createdByUserId], references: [id])

  links       CommunicationOperationalLink[]
  reflections CommunicationOperationalReflection[]

  @@unique([createdByUserId, clientRoomId])
  @@index([roomClass, updatedAt])
  @@index([createdByUserId, createdAt])
}

model CommunicationOperationalLink {
  id     String @id @default(cuid())
  roomId String

  targetType    CommunicationOperationalTargetType
  targetSubtype String
  targetId      String

  linkedByUserId String
  linkedAt       DateTime @default(now())

  room CommunicationOperationalRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  linkedBy User @relation("CommunicationOperationalLinkCreator", fields: [linkedByUserId], references: [id])

  @@unique([roomId, targetType, targetSubtype, targetId])
  @@index([targetType, targetSubtype, targetId])
  @@index([linkedByUserId, linkedAt])
}

model CommunicationOperationalReflection {
  id String @id @default(cuid())

  operationalRoomId String

  sourceSystem  String
  sourceEventId String

  sourceAggregateType String
  sourceAggregateId   String
  sourceEventType     String
  sourceOccurredAt    DateTime

  targetType    CommunicationOperationalTargetType
  targetSubtype String
  targetId      String

  reflectionType String
  reflectionCode String

  createdAt DateTime @default(now())

  operationalRoom CommunicationOperationalRoom @relation(fields: [operationalRoomId], references: [id], onDelete: Cascade)

  @@unique([operationalRoomId, sourceSystem, sourceEventId])
  @@index([operationalRoomId, sourceOccurredAt])
  @@index([targetType, targetSubtype, targetId])
}

model CommunicationReflectionIntakeCursor {
  sourceSystem String @id

  lastSequence BigInt
  lastEventId  String?

  initializedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TreasuryGatewayAggregate {
  aggregateType String
  aggregateId   String

  version Int
  status  String

  snapshot Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([aggregateType, aggregateId])
  @@index([aggregateType, status])
  @@index([updatedAt])
}

model TreasuryGatewayEvent {
  sequence BigInt @id @default(autoincrement())

  eventId String @unique

  aggregateType    String
  aggregateId      String
  aggregateVersion Int

  eventType String

  actorId          String?
  authorityGrantId String?

  correlationId String
  causationId   String?

  payload Json

  occurredAt DateTime
  recordedAt DateTime @default(now())

  previousEventHash String?
  eventHash         String?

  @@unique([aggregateType, aggregateId, aggregateVersion])
  @@index([aggregateType, aggregateId, sequence])
  @@index([correlationId])
  @@index([eventType, recordedAt])
}

enum TreasurySettlementObservationDirection {
  IN
  OUT
}

enum TreasurySettlementObservationStatus {
  DETECTED
  VALIDATED
  CONFIRMING
  CONFIRMED
  FAILED
  ORPHANED
}

model TreasurySettlementObservation {
  id String @id @default(cuid())

  chainId Int
  network String

  tokenContractAddress String

  txHash   String
  logIndex Int

  blockNumber BigInt
  blockHash   String?

  fromAddress String
  toAddress   String

  amountBaseUnits Decimal @db.Decimal(78, 0)

  direction TreasurySettlementObservationDirection
  status    TreasurySettlementObservationStatus    @default(DETECTED)

  detectedAt     DateTime
  chainTimestamp DateTime?
  validatedAt    DateTime?
  confirmedAt    DateTime?

  confirmationCount     Int @default(0)
  requiredConfirmations Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chainId, txHash, logIndex])
  @@index([chainId, tokenContractAddress, toAddress, status])
  @@index([status, blockNumber])
  @@index([txHash])
}

model TreasurySettlementObservationCursor {
  id String @id @default(cuid())

  chainId Int
  network String

  tokenContractAddress String
  watchedAddress       String

  lastScannedBlock     BigInt
  lastScannedBlockHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chainId, tokenContractAddress, watchedAddress])
  @@index([chainId, updatedAt])
}

// ============================================================================
// INSTITUTIONAL INSTRUMENT GOVERNANCE KERNEL
// ============================================================================

model InstrumentAuthority {
  id              String                   @id @default(cuid())
  instrumentId    String
  authorityKey    String
  title           String
  authorityClass  InstrumentAuthorityClass
  holderPartyId   String?
  action          String
  conditions      Json?
  effectiveAt     DateTime                 @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdByUserId String

  instrument  InstitutionalInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  holderParty InstrumentParty?        @relation(fields: [holderPartyId], references: [id], onDelete: SetNull)
  createdBy   User                    @relation("InstrumentAuthorityCreator", fields: [createdByUserId], references: [id])

  transitions InstrumentStateTransition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instrumentId, authorityKey])
  @@index([instrumentId, authorityClass])
  @@index([holderPartyId])
  @@index([revokedAt])
}

model InstrumentStateTransition {
  id           String                         @id @default(cuid())
  instrumentId String
  fromStatus   InstitutionalInstrumentStatus?
  toStatus     InstitutionalInstrumentStatus
  actorUserId  String
  authorityId  String?
  reason       String?
  metadata     Json?
  occurredAt   DateTime                       @default(now())

  instrument InstitutionalInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  actor      User                    @relation("InstrumentTransitionActor", fields: [actorUserId], references: [id])
  authority  InstrumentAuthority?    @relation(fields: [authorityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([instrumentId, occurredAt])
  @@index([instrumentId, toStatus])
  @@index([actorUserId])
  @@index([authorityId])
}

model InstrumentEvidence {
  id               String                    @id @default(cuid())
  instrumentId     String
  evidenceType     InstrumentEvidenceType
  subjectType      InstrumentEvidenceSubject
  subjectId        String?
  title            String
  uri              String?
  contentHash      String?
  metadata         Json?
  recordedByUserId String
  recordedAt       DateTime                  @default(now())

  instrument InstitutionalInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  recordedBy User                    @relation("InstrumentEvidenceRecorder", fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([instrumentId, evidenceType])
  @@index([instrumentId, subjectType, subjectId])
  @@index([contentHash])
  @@index([recordedAt])
}

model InstrumentRelation {
  id                 String                 @id @default(cuid())
  sourceInstrumentId String
  targetInstrumentId String
  relationType       InstrumentRelationType
  label              String?
  metadata           Json?
  createdByUserId    String

  sourceInstrument InstitutionalInstrument @relation("InstrumentRelationSource", fields: [sourceInstrumentId], references: [id], onDelete: Cascade)
  targetInstrument InstitutionalInstrument @relation("InstrumentRelationTarget", fields: [targetInstrumentId], references: [id], onDelete: Cascade)
  createdBy        User                    @relation("InstrumentRelationCreator", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  @@unique([sourceInstrumentId, targetInstrumentId, relationType])
  @@index([sourceInstrumentId, relationType])
  @@index([targetInstrumentId, relationType])
  @@index([createdByUserId])
}

enum InstrumentAuthorityClass {
  RESERVED
  JOINT
  DELEGATED
  PROHIBITED
}

enum InstrumentEvidenceType {
  DOCUMENT
  ATTESTATION
  EXTERNAL_RECORD
  DIGITAL_PROOF
  COMMERCIAL_RECORD
  SETTLEMENT_PROOF
  OTHER
}

enum InstrumentEvidenceSubject {
  INSTRUMENT
  VERSION
  PROPOSITION
  AUTHORITY
  TRANSITION
  RELATION
  EXECUTION
}

enum InstrumentRelationType {
  GOVERNS
  IMPLEMENTS
  DERIVES_FROM
  SUPERSEDES
  SUPPORTS
  SETTLES
  REFERENCES
}
